# This repository tracks the pipeline, its documentation, its results and the
# files TRaCE.pl was given. Everything else in the working directory is a raw
# input, a third-party tool or an intermediate file that the pipeline can make
# again (see README.md), so the rule is: ignore everything, then name what is
# kept.
/*
!/.gitignore
!/README.md
!/config.sh
!/bin/
!/manifest/
!/results/

# The direct inputs to TRaCE.pl: the gene models as it reads them, the Pfam
# table (and the InterPro-integrated subset used by one rerun), and one
# StringTie assembly per sample.
!/ref/
/ref/*
!/ref/TAIR12.trace.gff
!/domains/
/domains/*
!/domains/pfam.all.tsv
!/domains/pfam.ipr.tsv
!/stringtie/
/stringtie/*
!/stringtie/*.gtf

# Of the logs, only the list of installed conda packages is kept.
!/logs/
/logs/*
!/logs/conda_env.txt

# Working files for a database update, not output of the pipeline.
/results/gene_stable_id.canonical_transcript_stable_id.txt
/results/gsid.gid.tsid.tid.txt

__pycache__/
*.pyc
